# Settings
DATABASE_URL="postgres://postgres:postgres@localhost:5432/medisync?schema=public"
HOST=127.0.0.1
LOG_LEVEL=INFO
PORT=3000

FRONT_URL="http://localhost:4270"
CORS_ORIGIN="http://localhost:4270"

JWT_SECRET=medisync-jwt
JWT_REFRESH_SECRET=medisync-refresh
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=180d
COOKIE_SECRET=medisync-cookie

# E-mails : Mailpit en local (`docker compose --profile dev up -d` dans deploy/), UI sur
# http://localhost:8027. Sans SMTP_HOST, aucun e-mail ne part.
SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_FROM="MediSync <no-reply@medisync.local>"
