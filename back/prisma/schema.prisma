// Multi-tenant : toute table de service porte establishmentId + serviceId,
// toute table d'établissement porte establishmentId. Les références vers un
// autre modèle de tenant sont composites (xId, serviceId|establishmentId)
// sauf quand le champ référent est nullable (Prisma l'interdit) : la
// cohérence est alors vérifiée par le domaine. Voir docs/multi-tenant/.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

enum EstablishmentRole {
  ADMIN
  MEMBER
}

enum ServiceRole {
  COORDINATEUR
  INTERVENANT
  SECRETARIAT
  LECTURE
}

enum AppointmentType {
  ambulatory
  hospital
  telephonic
}

enum AppointmentStatus {
  yes
  no
}

model Establishment {
  id            String    @id @default(cuid())
  name          String
  createdAt     DateTime  @default(now())
  deactivatedAt DateTime?

  services               Service[]
  memberships            EstablishmentMembership[]
  patients               Patient[]
  soignants              Soignant[]
  locations              Location[]
  superAdminAccessGrants SuperAdminAccessGrant[]
}

model Service {
  id              String    @id @default(cuid())
  establishmentId String
  name            String
  createdAt       DateTime  @default(now())
  deactivatedAt   DateTime?

  establishment       Establishment         @relation(fields: [establishmentId], references: [id])
  memberships         ServiceMembership[]
  patientServiceFiles PatientServiceFile[]
  accessLogs          PatientAccessLog[]

  @@unique([establishmentId, name])
  @@unique([id, establishmentId])
}

model EstablishmentMembership {
  id              String            @id @default(cuid())
  userId          String
  establishmentId String
  role            EstablishmentRole @default(MEMBER)
  soignantId      String?
  createdAt       DateTime          @default(now())

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment      Establishment       @relation(fields: [establishmentId], references: [id])
  // Référence simple (composite impossible : soignantId nullable, establishmentId requis).
  // La cohérence d'établissement est vérifiée par MembershipDomain.
  soignant           Soignant?           @relation(fields: [soignantId], references: [id], onDelete: SetNull)
  serviceMemberships ServiceMembership[]

  @@unique([userId, establishmentId])
  @@unique([id, establishmentId])
  @@index([establishmentId])
  @@index([soignantId])
}

model ServiceMembership {
  id                        String      @id @default(cuid())
  establishmentMembershipId String
  serviceId                 String
  establishmentId           String
  role                      ServiceRole
  createdAt                 DateTime    @default(now())

  establishmentMembership EstablishmentMembership @relation(fields: [establishmentMembershipId], references: [id], onDelete: Cascade)
  service                 Service                 @relation(fields: [serviceId, establishmentId], references: [id, establishmentId])

  @@unique([establishmentMembershipId, serviceId])
  @@index([serviceId])
}

model SlotTemplateSoignant {
  slotTemplateId  String
  soignantId      String
  serviceId       String
  establishmentId String

  slotTemplate SlotTemplate @relation(fields: [slotTemplateId, serviceId], references: [id, serviceId], onDelete: Cascade)
  soignant     Soignant     @relation(fields: [soignantId, establishmentId], references: [id, establishmentId], onDelete: Cascade)

  @@id([slotTemplateId, soignantId])
  @@index([soignantId])
  @@index([serviceId])
}

model SoignantThematic {
  soignantId      String
  thematicId      String
  serviceId       String
  establishmentId String

  soignant Soignant @relation(fields: [soignantId, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  thematic Thematic @relation(fields: [thematicId, serviceId], references: [id, serviceId], onDelete: Cascade)

  @@id([soignantId, thematicId])
  @@index([thematicId])
  @@index([serviceId])
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  salt          String
  firstName     String?
  lastName      String?
  isSuperAdmin  Boolean   @default(false)
  deactivatedAt DateTime?
  lastLoginAt   DateTime?

  establishmentMemberships EstablishmentMembership[]
  accessLinks              AccessLink[]
  superAdminAccessGrants   SuperAdminAccessGrant[]
}

model PathwayTemplate {
  id                   String   @id @default(cuid())
  establishmentId      String
  serviceId            String
  name                 String
  color                String
  mainTag              String
  secondaryTags        String[]
  displayOrder         Int      @default(0)
  motifRequired        Boolean  @default(false)
  firstAppointmentOnly Boolean  @default(false)

  pathways      Pathway[]
  slotTemplates SlotTemplate[]

  @@unique([id, serviceId])
  @@index([serviceId])
}

model Pathway {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String
  startDate       DateTime @db.Date
  templateID      String?

  // Référence simple (templateID nullable) : cohérence vérifiée par PathwayDomain.
  template          PathwayTemplate?         @relation(fields: [templateID], references: [id])
  slots             Slot[]
  patientPriorities PatientPathwayPriority[]

  @@unique([id, serviceId])
  @@index([startDate])
  @@index([templateID])
  @@index([serviceId])
}

model PatientPathwayPriority {
  patientID       String
  pathwayID       String
  establishmentId String
  serviceId       String
  priority        Int

  patient Patient @relation(fields: [patientID, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  pathway Pathway @relation(fields: [pathwayID, serviceId], references: [id, serviceId], onDelete: Cascade)

  @@id([patientID, pathwayID])
  @@index([patientID, priority])
  @@index([serviceId])
}

model Appointment {
  id                  String               @id @default(cuid())
  establishmentId     String
  serviceId           String
  startDate           DateTime
  endDate             DateTime
  thematicId          String?
  type                AppointmentType?
  // Texte libre saisi à la prise de rendez-vous sur un créneau individuel.
  motif               String?
  slotID              String
  appointmentPatients AppointmentPatient[]

  // Cascade : supprimer un créneau supprime ses rendez-vous (et, en cascade,
  // les AppointmentPatient). Sans cela, supprimer un créneau/parcours avec
  // des rendez-vous échoue sur une violation de clé étrangère.
  slot     Slot      @relation(fields: [slotID, serviceId], references: [id, serviceId], onDelete: Cascade)
  thematic Thematic? @relation(fields: [thematicId], references: [id], onDelete: SetNull)

  @@unique([id, serviceId])
  @@index([slotID])
  @@index([thematicId])
  @@index([serviceId])
}

model AppointmentPatient {
  id              String @id @default(cuid())
  establishmentId String
  serviceId       String
  appointmentId   String
  patientId       String

  accompanying      String?
  status            AppointmentStatus?
  rejectionReason   String?
  transmissionNotes String?

  appointment Appointment @relation(fields: [appointmentId, serviceId], references: [id, serviceId], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId, establishmentId], references: [id, establishmentId], onDelete: Cascade)

  @@unique([appointmentId, patientId])
  @@unique([id, serviceId])
  @@index([patientId])
  @@index([serviceId])
}

model SlotTemplate {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String
  startTime       DateTime @db.Time()
  endTime         DateTime @db.Time()
  offsetDays      Int

  isIndividual Boolean
  capacity     Int?
  thematicId   String?
  locationID   String?
  description  String?
  color        String

  slot       Slot?
  templateID String?

  soignantLinks SlotTemplateSoignant[]
  template      PathwayTemplate?       @relation(fields: [templateID], references: [id])
  location      Location?              @relation(fields: [locationID], references: [id], onDelete: SetNull)
  thematic      Thematic?              @relation(fields: [thematicId], references: [id], onDelete: SetNull)

  @@unique([id, serviceId])
  @@index([templateID])
  @@index([locationID])
  @@index([thematicId])
  @@index([serviceId])
}

model Slot {
  id              String        @id @default(cuid())
  establishmentId String
  serviceId       String
  startDate       DateTime
  endDate         DateTime
  locked          Boolean       @default(false)
  appointments    Appointment[]
  pathwayID       String?
  slotTemplateID  String        @unique

  pathway      Pathway?     @relation(fields: [pathwayID], references: [id])
  slotTemplate SlotTemplate @relation(fields: [slotTemplateID, serviceId], references: [id, serviceId])

  @@unique([id, serviceId])
  // Requis par Prisma pour la relation un-à-un composite ci-dessus (le champ
  // doit être couvert par une unicité portant exactement sur ce couple de
  // colonnes) ; redondant avec le @unique sur slotTemplateID seul, conservé
  // pour la garantie plus forte (un modèle de créneau n'a jamais deux slots).
  @@unique([slotTemplateID, serviceId])
  @@index([startDate])
  @@index([pathwayID])
  @@index([serviceId])
}

model Soignant {
  id              String @id @default(cuid())
  establishmentId String
  name            String

  establishment     Establishment             @relation(fields: [establishmentId], references: [id])
  slotTemplateLinks SlotTemplateSoignant[]
  thematicLinks     SoignantThematic[]
  todos             Todo[]
  memberships       EstablishmentMembership[]

  @@unique([id, establishmentId])
  @@index([establishmentId])
}

model Thematic {
  id              String  @id @default(cuid())
  establishmentId String
  serviceId       String
  name            String
  duration        Int?
  // Consigne affichee au patient dans le PDF du programme, avant chaque
  // semaine contenant un creneau de cette thematique.
  pdfNotice       String?

  soignantLinks SoignantThematic[]
  appointments  Appointment[]
  slotTemplates SlotTemplate[]

  @@unique([serviceId, name])
  @@unique([id, serviceId])
  @@index([serviceId])
}

model Location {
  id              String @id @default(cuid())
  establishmentId String
  name            String

  establishment Establishment  @relation(fields: [establishmentId], references: [id])
  slotTemplates SlotTemplate[]

  @@unique([establishmentId, name])
  @@unique([id, establishmentId])
}

model Patient {
  id              String @id @default(cuid())
  establishmentId String

  // Identity
  firstName String
  lastName  String
  gender    String?
  birthDate DateTime? @db.Date

  // Contact
  phone1 String?
  phone2 String?
  email  String?

  // Personal & Social Info
  distance        String? // Distance d'habitation
  educationLevel  String? // Niveau d’étude
  occupation      String? // Profession
  currentActivity String? // Activité actuelle

  createDate DateTime

  establishment       Establishment            @relation(fields: [establishmentId], references: [id])
  appointmentPatients AppointmentPatient[]
  pathwayPriorities   PatientPathwayPriority[]
  serviceFiles        PatientServiceFile[]
  accessLogs          PatientAccessLog[]

  @@unique([id, establishmentId])
  @@index([establishmentId])
}

// Sous-dossier d'un patient dans un service. L'identite reste sur `Patient`,
// au niveau de l'etablissement ; tout ce qui releve du parcours de soin vit
// ici, invisible des autres services.
model PatientServiceFile {
  id              String @id @default(cuid())
  patientId       String
  serviceId       String
  establishmentId String

  referringCaregiver String?
  followUpToDo       String?
  notes              String?
  details            String?

  medicalDiagnosis     String?
  entryDate            DateTime? @db.Date
  careMode             String?
  orientation          String?
  etpDecision          String?
  programType          String?
  nonInclusionDetails  String?
  customContentDetails String?
  goal                 String?

  exitDate        DateTime? @db.Date
  stopReason      String?
  etpFinalOutcome String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  service Service @relation(fields: [serviceId, establishmentId], references: [id, establishmentId])

  diagnostics      DiagnosticEducatif[]
  enrollmentIssues EnrollmentIssue[]

  @@unique([patientId, serviceId])
  @@unique([id, serviceId])
  @@index([serviceId])
  @@index([patientId])
}

// Journal des consultations : qui a ouvert le dossier de quel patient, quand, et le detail d'un
// export eventuel (nombre de lignes, filtres). Modele de service, sur le patron exact de
// PatientServiceFile (cles composites, @@unique([id, serviceId])).
//
// LA CASCADE EST UNE DECISION, PAS UN DEFAUT. `onDelete: Cascade` depuis Patient efface
// l'historique de consultation au moment meme ou le dossier est supprime -- soit potentiellement
// au moment precis ou cet historique devient interessant a lire. Motif retenu, et son cout :
// conserver les lignes apres suppression du patient laisserait un journal qui designe un dossier
// qui n'existe plus, et `patientId` deviendrait une cle morte ; les effacer perd la trace de qui
// avait consulte ce dossier avant sa suppression. Deux points verifies dans le code, pas
// seulement affirmes ici, ont fait pencher vers la cascade : (1) la suppression du patient reste
// elle-meme journalisee ailleurs, avec son auteur -- `PatientDomain.delete` emet
// `patient.deleted` (`userID`, `patientId`), capte par `ActivityLogSubscriber`
// (`services/activity-log.subscriber.ts`), qui ecrit une ligne `ActivityLog` nommant l'auteur ;
// (2) `PatientServiceFile`, le dossier clinique lui-meme, cascade DEJA depuis `Patient` (meme
// relation, meme `onDelete`) -- la donnee que ce journal decrirait avoir ete consultee disparait
// donc de toute facon au meme instant, ce qui affaiblit l'interet de garder ce journal-ci
// orphelin d'elle. Cout accepte, a nommer plutot qu'a taire : si une consultation abusive precede
// de peu la suppression du patient (par le meme acteur, ou un complice qui couvre ses traces), le
// detail fin -- qui, quand, combien de lignes exportees -- est perdu avec elle ; seule la ligne
// `patient.deleted` demeure, sans le detail des consultations qui l'ont precedee. Si ce risque
// devait un jour compter plus que la coherence referentielle (par exemple pour une obligation
// reglementaire de conserver la preuve d'acces meme apres suppression du dossier), la ligne a
// changer est celle-ci -- pas une lecture silencieuse du gap ailleurs.
model PatientAccessLog {
  id              String @id @default(cuid())
  establishmentId String
  serviceId       String
  patientId       String

  userID        String
  userFirstName String?
  userLastName  String?

  action        String
  exportCount   Int?
  exportFilters String?

  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId, establishmentId], references: [id, establishmentId], onDelete: Cascade)
  service Service @relation(fields: [serviceId, establishmentId], references: [id, establishmentId])

  @@unique([id, serviceId])
  @@index([patientId])
  @@index([createdAt])
  @@index([establishmentId, serviceId])
}

model EnrollmentIssue {
  id                String   @id @default(cuid())
  establishmentId   String
  serviceId         String
  patientId         String
  pathwayTemplateID String
  pathwayName       String?
  reason            String
  startDate         DateTime
  createdAt         DateTime @default(now())

  // Relation dérivée de patientId + serviceId, déjà portées par ce modèle : aucune colonne
  // supplémentaire, elle relie simplement la ligne à son sous-dossier de service. Seul parent
  // désormais (la tâche 6 a retiré la relation `patient` vers Patient(id, establishmentId) qui
  // coexistait ici) : ce modèle est un modèle de service, il dépend d'un sous-dossier de
  // service, pas d'un parent d'établissement.
  serviceFile PatientServiceFile @relation(fields: [patientId, serviceId], references: [patientId, serviceId], onDelete: Cascade)

  @@unique([id, serviceId])
  @@index([patientId])
  @@index([serviceId])
}

model DiagnosticEducatifTemplate {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String
  name            String
  activeFields    String[]

  diagnostics DiagnosticEducatif[]

  @@unique([id, serviceId])
  @@index([serviceId])
}

model DiagnosticEducatif {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String
  createdAt       DateTime @default(now())
  title           String?
  activeFields    String[]

  patientId  String
  templateId String?

  // Facteurs de risque
  facteursRisque String?
  contexte       String?

  // Qu'est-ce qu'il fait ? — Qualité de vie
  qualiteVie         String?
  qualiteVieLibre    String?
  viePersonnelle     String?
  vieProfessionnelle String?
  occupations        String?
  loisirs            String?

  // Qu'est-ce qu'il a ? — Implication
  implication      String?
  implicationLibre String?

  // Qu'est-ce qu'il a ? — Priorité de santé
  prioriteSante      String?
  prioriteSanteLibre String?

  // Qu'est-ce qu'il sait ? — Connaissances maladie
  connaissancesMaladie      String?
  connaissancesMaladieLibre String?
  mecanismes                String?
  localisations             String?
  symptomes                 String?
  chronicite                String?
  reagirSignesAlerte        String?

  // Qu'est-ce qu'il sait ? — Identification FDR
  identificationFDR      String?
  identificationFDRLibre String?
  ometFDR                String?

  // Savoir-faire — Tension artérielle
  gestionTensionArterielle                        String?
  gestionTensionArterielleLibre                   String?
  gestionTensionArterielleSentimentAutoEfficacite String?
  gestionTensionArterielleEtapeChangement         String?

  // Savoir-faire — HbA1c
  gestionHba1c                        String?
  gestionHba1cLibre                   String?
  gestionHba1cSentimentAutoEfficacite String?
  gestionHba1cEtapeChangement         String?

  // Savoir-faire — LDL
  gestionLDL                        String?
  gestionLDLLibre                   String?
  gestionLDLSentimentAutoEfficacite String?
  gestionLDLEtapeChangement         String?

  // Savoir-faire — Adhésion traitement
  adhesionTraitement                        String?
  adhesionTraitementLibre                   String?
  adhesionTraitementSentimentAutoEfficacite String?
  adhesionTraitementEtapeChangement         String?

  // Savoir-faire — Alimentation
  alimentation                        String?
  alimentationLibre                   String?
  alimentationSentimentAutoEfficacite String?
  alimentationEtapeChangement         String?

  // Savoir-faire — Gestion du stress
  gestionStress                        String?
  gestionStressLibre                   String?
  gestionStressSentimentAutoEfficacite String?
  gestionStressEtapeChangement         String?

  // Savoir-faire — Tabac
  consommationTabac                        String?
  consommationTabacNombreCigaretteJour     Int?
  consommationTabacLibre                   String?
  consommationTabacSentimentAutoEfficacite String?
  consommationTabacEtapeChangement         String?

  // Savoir-faire — Tour de taille
  gestionTourTaille                        String?
  gestionTourTailleLibre                   String?
  gestionTourTailleSentimentAutoEfficacite String?
  gestionTourTailleEtapeChangement         String?

  // Savoir-faire — Activité physique
  activitePhysique                        String?
  activitePhysiqueLibre                   String?
  activitePhysiqueSentimentAutoEfficacite String?
  activitePhysiqueEtapeChangement         String?

  // Savoir-faire — Gestion globale FDR
  gestionFDR String?

  // Qui est-il ?
  impactSurQualiteVie     String?
  stadeAcceptationMaladie String?
  soutienSocial           String?
  projetDeVie             String?
  objectifsPatient        String?
  objectifsSoignants      String?
  suiviEducatifNegocie    String?
  rapatrier               String?

  // Référence simple (templateId nullable) : cohérence vérifiée par le domaine.
  template DiagnosticEducatifTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  // Relation dérivée de patientId + serviceId, déjà portées par ce modèle : aucune colonne
  // supplémentaire, elle relie simplement la ligne à son sous-dossier de service. Seul parent
  // désormais (la tâche 6 a retiré la relation `patient` vers Patient(id, establishmentId) qui
  // coexistait ici) : ce modèle est un modèle de service, il dépend d'un sous-dossier de
  // service, pas d'un parent d'établissement.
  serviceFile PatientServiceFile @relation(fields: [patientId, serviceId], references: [patientId, serviceId], onDelete: Cascade)

  @@unique([id, serviceId])
  @@index([patientId])
  @@index([templateId])
  @@index([serviceId])
}

model Todo {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String
  createDate      DateTime
  title           String
  description     String?
  completed       Boolean

  soignantID String?

  soignant Soignant? @relation(fields: [soignantID], references: [id], onDelete: SetNull)

  @@unique([id, serviceId])
  @@index([soignantID])
  @@index([serviceId])
}

model ActivityLog {
  id              String   @id @default(cuid())
  establishmentId String?
  serviceId       String?
  userID          String
  userFirstName   String?
  userLastName    String?
  action          String
  entityType      String
  entityID        String
  createdAt       DateTime @default(now())

  @@index([userID])
  @@index([action])
  @@index([createdAt])
  @@index([establishmentId])
  @@index([serviceId])
}

model ForbiddenWeek {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String
  startOfWeek     DateTime @db.Date
  createdAt       DateTime @default(now())

  @@unique([id, serviceId])
  @@unique([serviceId, startOfWeek])
  @@index([serviceId])
}

model PlanningCycle {
  id              String   @id @default(cuid())
  establishmentId String
  serviceId       String   @unique
  startOfWeek     DateTime @db.Date
  weekCount       Int
  updatedAt       DateTime @updatedAt
}

model AccessLink {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SuperAdminAccessGrant {
  id              String    @id @default(cuid())
  userId          String
  establishmentId String
  reason          String
  grantedAt       DateTime  @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id])

  @@index([establishmentId, expiresAt])
  @@index([userId])
}
