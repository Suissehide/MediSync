datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

enum Role {
  NONE
  USER
  ADMIN
}

enum AppointmentType {
  ambulatory
  hospital
  telephonic
}

enum AppointmentStatus {
  yes
  no
}

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  password   String
  salt       String
  firstName  String?
  lastName   String?
  role       Role      @default(NONE)
  soignantId String?

  soignant Soignant? @relation(fields: [soignantId], references: [id], onDelete: SetNull)

  @@index([soignantId])
}

model PathwayTemplate {
  id           String   @id @default(cuid())
  name         String
  color        String
  tags         String[]
  displayOrder  Int      @default(0)
  motifRequired        Boolean  @default(false)
  firstAppointmentOnly Boolean  @default(false)

  pathways      Pathway[]
  slotTemplates SlotTemplate[]
}

model Pathway {
  id         String   @id @default(cuid())
  startDate  DateTime @db.Date
  templateID String?

  template          PathwayTemplate?          @relation(fields: [templateID], references: [id])
  slots             Slot[]
  patientPriorities PatientPathwayPriority[]

  @@index([startDate])
  @@index([templateID])
}

model PatientPathwayPriority {
  patientID String
  pathwayID String
  priority  Int

  patient Patient @relation(fields: [patientID], references: [id], onDelete: Cascade)
  pathway Pathway @relation(fields: [pathwayID], references: [id], onDelete: Cascade)

  @@id([patientID, pathwayID])
  @@index([patientID, priority])
}

model Appointment {
  id                  String               @id @default(cuid())
  startDate           DateTime
  endDate             DateTime
  thematicId          String?
  type                AppointmentType?
  slotID              String
  appointmentPatients AppointmentPatient[]

  // Cascade : supprimer un créneau supprime ses rendez-vous (et, en cascade,
  // les AppointmentPatient). Sans cela, supprimer un créneau/parcours avec
  // des rendez-vous échoue sur une violation de clé étrangère.
  slot     Slot      @relation(fields: [slotID], references: [id], onDelete: Cascade)
  thematic Thematic? @relation(fields: [thematicId], references: [id], onDelete: SetNull)

  @@index([slotID])
  @@index([thematicId])
}

model AppointmentPatient {
  id            String @id @default(cuid())
  appointmentId String
  patientId     String

  accompanying      String?
  status            AppointmentStatus?
  rejectionReason   String?
  transmissionNotes String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, patientId])
  @@index([patientId])
}

model SlotTemplate {
  id         String   @id @default(cuid())
  startTime  DateTime @db.Time()
  endTime    DateTime @db.Time()
  offsetDays Int

  isIndividual Boolean
  capacity     Int?
  thematicId   String?
  locationID   String?
  description  String?
  color        String

  slot       Slot?
  templateID String?

  soignants Soignant[]      @relation("SlotTemplateSoignants")
  template PathwayTemplate? @relation(fields: [templateID], references: [id])
  location Location?        @relation(fields: [locationID], references: [id], onDelete: SetNull)
  thematic Thematic?        @relation(fields: [thematicId], references: [id], onDelete: SetNull)

  @@index([templateID])
  @@index([locationID])
  @@index([thematicId])
}

model Slot {
  id             String        @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  locked         Boolean       @default(false)
  appointments   Appointment[]
  pathwayID      String?
  slotTemplateID String        @unique

  pathway      Pathway?     @relation(fields: [pathwayID], references: [id])
  slotTemplate SlotTemplate @relation(fields: [slotTemplateID], references: [id])

  @@index([startDate])
  @@index([pathwayID])
}

model Soignant {
  id   String @id @default(cuid())
  name String

  slotTemplates SlotTemplate[] @relation("SlotTemplateSoignants")
  todos         Todo[]
  thematics     Thematic[]     @relation("SoignantThematics")
  users         User[]
}

model Thematic {
  id        String     @id @default(cuid())
  name      String     @unique
  duration  Int?
  soignants Soignant[] @relation("SoignantThematics")

  appointments  Appointment[]
  slotTemplates SlotTemplate[]
}

model Location {
  id   String @id @default(cuid())
  name String @unique

  slotTemplates SlotTemplate[]
}

model Patient {
  id String @id @default(cuid())

  // Identity
  firstName String
  lastName  String
  gender    String?
  birthDate DateTime? @db.Date

  // Contact
  phone1 String?
  phone2 String?
  email  String?

  // Personal & Social Info
  distance        String? // Distance d'habitation
  educationLevel  String? // Niveau d’étude
  occupation      String? // Profession
  currentActivity String? // Activité actuelle

  // Referrals & Context
  referringCaregiver String? // Soignant référent
  followUpToDo       String? // Suivi à régulariser

  // Notes
  notes   String?
  details String?

  // Inclusion Data
  medicalDiagnosis     String?
  entryDate            DateTime? @db.Date
  careMode             String? // Mode de prise en charge
  orientation          String?
  etpDecision          String? // ETP décision
  programType          String?
  nonInclusionDetails  String?
  customContentDetails String?
  goal                 String?

  // Exit Data
  exitDate        DateTime? @db.Date
  stopReason      String? // Motif d’arrêt de programme
  etpFinalOutcome String? // Point final parcours ETP

  createDate DateTime

  appointmentPatients AppointmentPatient[]
  diagnostics         DiagnosticEducatif[]
  enrollmentIssues    EnrollmentIssue[]
  pathwayPriorities   PatientPathwayPriority[]
}

model EnrollmentIssue {
  id                String   @id @default(cuid())
  patientId         String
  pathwayTemplateID String
  pathwayName       String?
  reason            String
  startDate         DateTime
  createdAt         DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model DiagnosticEducatifTemplate {
  id           String   @id @default(cuid())
  name         String
  activeFields String[]

  diagnostics DiagnosticEducatif[]
}

model DiagnosticEducatif {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  title        String?
  activeFields String[]

  patientId  String
  templateId String?

  // Facteurs de risque
  facteursRisque String?
  contexte       String?

  // Qu'est-ce qu'il fait ? — Qualité de vie
  qualiteVie         String?
  qualiteVieLibre    String?
  viePersonnelle     String?
  vieProfessionnelle String?
  occupations        String?
  loisirs            String?

  // Qu'est-ce qu'il a ? — Implication
  implication      String?
  implicationLibre String?

  // Qu'est-ce qu'il a ? — Priorité de santé
  prioriteSante      String?
  prioriteSanteLibre String?

  // Qu'est-ce qu'il sait ? — Connaissances maladie
  connaissancesMaladie      String?
  connaissancesMaladieLibre String?
  mecanismes                String?
  localisations             String?
  symptomes                 String?
  chronicite                String?
  reagirSignesAlerte        String?

  // Qu'est-ce qu'il sait ? — Identification FDR
  identificationFDR      String?
  identificationFDRLibre String?
  ometFDR                String?

  // Savoir-faire — Tension artérielle
  gestionTensionArterielle                        String?
  gestionTensionArterielleLibre                   String?
  gestionTensionArterielleSentimentAutoEfficacite String?
  gestionTensionArterielleEtapeChangement         String?

  // Savoir-faire — HbA1c
  gestionHba1c                        String?
  gestionHba1cLibre                   String?
  gestionHba1cSentimentAutoEfficacite String?
  gestionHba1cEtapeChangement         String?

  // Savoir-faire — LDL
  gestionLDL                        String?
  gestionLDLLibre                   String?
  gestionLDLSentimentAutoEfficacite String?
  gestionLDLEtapeChangement         String?

  // Savoir-faire — Adhésion traitement
  adhesionTraitement                        String?
  adhesionTraitementLibre                   String?
  adhesionTraitementSentimentAutoEfficacite String?
  adhesionTraitementEtapeChangement         String?

  // Savoir-faire — Alimentation
  alimentation                        String?
  alimentationLibre                   String?
  alimentationSentimentAutoEfficacite String?
  alimentationEtapeChangement         String?

  // Savoir-faire — Gestion du stress
  gestionStress                        String?
  gestionStressLibre                   String?
  gestionStressSentimentAutoEfficacite String?
  gestionStressEtapeChangement         String?

  // Savoir-faire — Tabac
  consommationTabac                        String?
  consommationTabacNombreCigaretteJour     Int?
  consommationTabacLibre                   String?
  consommationTabacSentimentAutoEfficacite String?
  consommationTabacEtapeChangement         String?

  // Savoir-faire — Tour de taille
  gestionTourTaille                        String?
  gestionTourTailleLibre                   String?
  gestionTourTailleSentimentAutoEfficacite String?
  gestionTourTailleEtapeChangement         String?

  // Savoir-faire — Activité physique
  activitePhysique                        String?
  activitePhysiqueLibre                   String?
  activitePhysiqueSentimentAutoEfficacite String?
  activitePhysiqueEtapeChangement         String?

  // Savoir-faire — Gestion globale FDR
  gestionFDR String?

  // Qui est-il ?
  impactSurQualiteVie     String?
  stadeAcceptationMaladie String?
  soutienSocial           String?
  projetDeVie             String?
  objectifsPatient        String?
  objectifsSoignants      String?
  suiviEducatifNegocie    String?
  rapatrier               String?

  patient  Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  template DiagnosticEducatifTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([templateId])
}

model Todo {
  id          String   @id @default(cuid())
  createDate  DateTime
  title       String
  description String?
  completed   Boolean

  soignantID String?

  soignant Soignant? @relation(fields: [soignantID], references: [id], onDelete: SetNull)

  @@index([soignantID])
}

model ActivityLog {
  id            String   @id @default(cuid())
  userID        String
  userFirstName String?
  userLastName  String?
  action        String
  entityType    String
  entityID      String
  createdAt     DateTime @default(now())

  @@index([userID])
  @@index([action])
  @@index([createdAt])
}

model ForbiddenWeek {
  id          String   @id @default(cuid())
  startOfWeek DateTime @unique @db.Date
  createdAt   DateTime @default(now())
}
