# Valeurs par defaut des tests. Si le Postgres du projet ne publie pas sur 5432
# (voir POSTGRES_PORT dans deploy/.env), creer back/.env.test.local, non versionne,
# qui surcharge ces valeurs : le premier fichier -e l'emporte dans dotenv-cli.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/medisync_test?schema=public"
HOST=127.0.0.1
LOG_LEVEL=silent
PORT=0
FRONT_URL="http://localhost:4270"
CORS_ORIGIN="http://localhost:4270"
JWT_SECRET=medisync-jwt-test
JWT_REFRESH_SECRET=medisync-refresh-test
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=medisync-cookie-test
JEST_RUNNING=true
