# Docker compose stack settings
COMPOSE_PROJECT_NAME='medisync'
CONTAINER_REGISTRY_PREFIX=''
VERSION=0.0.1

#
APP_IMAGE_NAME=medisync
# INFO, jamais debug en production : le niveau debug journalise la configuration chargee,
# et n'est pas le reglage sous lequel on veut lire des journaux d'application de sante.
LOG_LEVEL=INFO
# Retention des DEUX journaux — activite et consultations de dossiers. Entier strictement
# positif, en mois ; un zero, un negatif ou un non-nombre fait echouer le DEMARRAGE, et c'est
# voulu : une retention de zero prise au pied de la lettre effacerait les deux journaux au
# premier passage planifie, y compris une ligne vieille d'une minute (mesure, etape 4b).
# VALEUR PROVISOIRE : ces douze mois reprennent ceux qui etaient en dur dans le code. La duree
# de conservation d'un journal d'acces a des donnees de sante n'est pas un choix d'ingenierie
# et attend un conseil — voir docs/multi-tenant/deploiement-etape-4b.md, section 5.
LOG_RETENTION_MONTHS=12
NODE_VERSION=24.12.0
NPM_VERSION=11.8.0

# Backend
TRAEFIK_BACK_HOST=medisync-api.example.com
DATABASE_URL="postgres://postgres:CHANGE_ME@medisync-postgres:5432/medisync?schema=public"
HOST=0.0.0.0
# Secrets : generer une valeur aleatoire par environnement, ex. `openssl rand -hex 32`
JWT_SECRET="CHANGE_ME"
JWT_REFRESH_SECRET="CHANGE_ME"
JWT_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=180d
COOKIE_SECRET="CHANGE_ME"
PORT=3000
FRONT_URL="https://medisync.example.com"
CORS_ORIGIN="https://medisync.example.com"

# Frontend
TRAEFIK_FRONT_HOST="medisync.example.com"
VITE_ENVIRONMENT="production"
VITE_API_BASE_URL="https://medisync-api.example.com"

# Postgres container configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB_NAME=medisync
# Port publie sur la loopback de l'hote ; a changer si 5432 est deja pris.
POSTGRES_PORT=5432
